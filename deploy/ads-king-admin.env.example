ADMIN_HOST=127.0.0.1
ADMIN_PORT=8790
SITE_DATA_DIR=/opt/ads-king/site-data
UPLOAD_DIR=/opt/ads-king/uploads
ADMIN_DB_PATH=/opt/ads-king/data/admin.sqlite
ADMIN_BOOTSTRAP_USER=admin
ADMIN_BOOTSTRAP_PASS=ChangeMeNow1!
# 菠萝视频上游密钥与源站（实际值只存在 /etc/ads-king/admin.env，不进仓库）
BOLUO_API_KEY=
BOLUO_DATA_KEY=
BOLUO_IMG_KEY=
BOLUO_ORIGIN_BASES=
# 视频播放/分片地址的 HMAC 签名密钥。生产必须设为足够长的随机值；
# 留空时代码退化为内置 'dev-only-unsigned' 固定密钥，任何人都可伪造播放地址。
VIDEO_URL_SECRET=
# 支付内部接口共享密钥：najin-pay BFF 通过 x-pay-internal 请求头调用
# /api/internal/pay/{reserve,attach,fail,credit}。生产必须 ≥16 位随机值，
# 且与 /etc/ads-king/najin-pay.env 的 PAY_INTERNAL_TOKEN 完全一致；
# 未设置或过短时服务端一律按 403 拒绝。
PAY_INTERNAL_TOKEN=
# 仅本地开发允许在无签名密钥下运行的开关（配合 VIDEO_URL_SECRET 留空的
# dev 兜底路径）。生产必须为 0 或不设置，严禁以非 0 值带到线上。
ALLOW_DEV_UNSIGNED=0
