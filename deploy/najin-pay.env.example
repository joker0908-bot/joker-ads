# Copy to /etc/ads-king/najin-pay.env on VPS — never commit real values.
NAJIN_BFF_PORT=8787
NAJIN_MCH_ID=10028
NAJIN_KEY=your_merchant_key_here
NAJIN_PRODUCT_WX=8002
NAJIN_PRODUCT_ALI=8009
NAJIN_CREATE_URL=http://pay.najin.cfd/api/pay/create_order
NAJIN_QUERY_URL=http://pay.najin.cfd/api/pay/query_order
NAJIN_NOTIFY_URL=https://al-ads.com/pay-bff/notify
NAJIN_RETURN_URL=https://b12sl5x.cn/#/recharge?paid=1
# 跨域放行来源；缺省已收紧为 https://b12sl5x.cn，不要回退为 *
NAJIN_ALLOW_ORIGIN=https://b12sl5x.cn
# 支付内部接口共享密钥：/pay-bff/notify 验签成功后，BFF 以 x-pay-internal
# 请求头调用 ADMIN_INTERNAL_ORIGIN 的 /api/internal/pay/credit 完成入账。
# 必须与 /etc/ads-king/admin.env 的 PAY_INTERNAL_TOKEN 完全一致（≥16 位随机值）；
# 未配置时入账调用会被后台拒绝，回调将按失败重试。
PAY_INTERNAL_TOKEN=
# 后台内部接口地址。本机回环即可，不要指向公网入口。
ADMIN_INTERNAL_ORIGIN=http://127.0.0.1:8790
